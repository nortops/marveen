{
  "id": "marketer",
  "label": "Marketinges",
  "description": "Email-vázlat, hírlevél, social tartalom. Webes tartalmat olvas (prompt injection felület), ezért a deny-lista (SSH/AWS/.env, sudo, rm, curl -X POST) változatlanul szigorú, csak a saját mappájába írhat. A permissionMode viszont permissive a gazda 2026-09-07-i döntése szerint (TG 14764): strict alatt az ágens minden tool-hívásnál engedélykérő párbeszédre állt meg, amire nem-interaktív ágensben senki nem válaszol.",
  "permissionMode": "permissive",
  "filesystem": {
    "allow": [
      "Read(${AGENT_DIR}/**)",
      "Edit(${AGENT_DIR}/**)",
      "Read(${HOME}/Downloads/**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(date:*)",
      "Bash(cd:*)",
      "Bash(bash ${HOME}/Projects/marveen/scripts/dash.sh:*)",
      "Bash(${HOME}/Projects/marveen/scripts/dash.sh:*)",
      "Bash(curl -s -X POST http://localhost:3420/api/:*)",
      "Bash(curl -s -m 5 -X POST http://localhost:3420/api/:*)",
      "Bash(curl -s -X PUT http://localhost:3420/api/:*)",
      "Bash(curl -s -m 5 -X PUT http://localhost:3420/api/:*)",
      "Bash(curl -s -m 5 http://localhost:3420/api/:*)",
      "Bash(${HOME}/.local/share/atlas-whisper/stt.sh:*)",
      "Bash(${HOME}/.local/share/atlas-whisper/tts.sh:*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Bash(jq:*)",
      "Read(${HOME}/.claude/skills/**)",
      "Bash(${PROJECT_ROOT}/scripts/agent-post.sh:*)",
      "Bash(${PROJECT_ROOT}/scripts/notify.sh:*)"
    ],
    "deny": [
      "Read(${HOME}/.ssh/**)",
      "Read(${HOME}/.aws/**)",
      "Read(${HOME}/.gnupg/**)",
      "Read(${HOME}/.env)",
      "Read(**/.env)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(curl -X POST:*)"
    ]
  }
}
