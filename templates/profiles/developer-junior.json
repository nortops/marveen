{
  "id": "developer-junior",
  "label": "Fejlesztő (junior)",
  "description": "Feature-fejlesztésre saját branch-en. A main/master-re tiltott push, sudo tiltott, SSH/AWS kulcsok elrejtve. Permissive mód (bypass), hogy a custom-provider gateway-en ne akadjon el a permission-classifier; a kritikus deny-rács így is érvényben marad.",
  "permissionMode": "permissive",
  "filesystem": {
    "allow": [
      "Read(${AGENT_DIR}/**)",
      "Edit(${AGENT_DIR}/**)",
      "Read(/tmp/**)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd:*)",
      "Bash(curl:*)",
      "Bash(bash ${PROJECT_ROOT}/scripts/marveen-api.sh:*)",
      "Bash(bash ${PROJECT_ROOT}/scripts/agent-msg.sh:*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Bash(jq:*)"
    ],
    "deny": [
      "Read(${HOME}/.ssh/**)",
      "Read(${HOME}/.aws/**)",
      "Read(${HOME}/.gnupg/**)",
      "Bash(sudo:*)",
      "Bash(rm -rf ${HOME}:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)"
    ]
  }
}
